---
/**
 * SolutionsHandoffMobile — the mobile + tablet ( < lg ) "Problem → Solution" beat,
 * as ONE continuous panel:
 *
 *   1. The panel's hero opens on the Problem eyebrow + heading + text.
 *   2. Scrolling crossfades that (fade + blur, hero warming grey → purple) into
 *      the Solution eyebrow + heading + text, held in the same spot. The hero is
 *      pinned for this beat (the praised crossfade).
 *   3. Once the Solution has arrived the pin RELEASES: the SAME panel keeps going
 *      past the viewport and the stat cards flow beneath the header in normal page
 *      scroll — no pin — each card morphing from its Problem stat (with source "i")
 *      into the matching Solution outcome as it scrolls into view.
 *
 * Gated on JS + no-reduced-motion + mobile/tablet width; without it everything is
 * normal flow (solution header, then cards), all legible. Content comes from
 * src/data/solutions.json.
 */
import Eyebrow from "../ui/Eyebrow.astro";
import ArrowCircle from "../ui/ArrowCircle.astro";
import solutions from "../../data/solutions.json";
import { outcomeIcons } from "../ui/outcomeIcons";

const { problem, solution } = solutions;

// Each card starts on its Problem stat (before) and, when reached, morphs into
// the matching Solution outcome (after) — swapping in the same slot. The after
// state is either a "stat" (number + label, links out) or an "icon" card (a
// lavender icon disc + copy, no link) — the CMS picks per card, mixable.
const metrics = problem.cards.map((p, i) => {
  const s = solution.cards[i] as {
    variant?: "stat" | "icon";
    value?: string;
    label: string;
    href?: string;
    icon?: string;
  };
  return {
    before: { value: p.value, label: p.label, detail: p.detail },
    after: {
      variant: s.variant ?? "stat",
      value: s.value,
      label: s.label,
      href: s.href,
      icon: s.icon,
    },
  };
});
---

<section data-handoff-mobile class="handoff-mobile bg-surface px-5 py-[120px]">
  <div data-hm-panel class="hm-panel">
    {/* ---- Hero: Problem → Solution header crossfade (pinned, then releases) --- */}
    <div class="hm-hero">
      <div class="hm-hero-sticky">
        <img
          data-hm-bloom="problem"
          src="/solutions/problem-bloom.svg"
          alt=""
          aria-hidden="true"
          class="hm-bloom hm-bloom--problem"
        />
        <img
          data-hm-bloom="solution"
          src="/solutions/solution-bloom.svg"
          alt=""
          aria-hidden="true"
          class="hm-bloom hm-bloom--solution"
        />

        {/* Problem — centred, crossfades out */}
        <div data-hm-problem class="hm-problem">
          <Eyebrow>{problem.eyebrow}</Eyebrow>
          <h2 class="font-serif text-h6 font-normal text-black">
            {problem.heading}
          </h2>
          <p class="max-w-[34ch] text-lg text-black">{problem.subheading}</p>
        </div>

        {/* Solution header — crossfades in, held in the same spot */}
        <div data-hm-shead class="hm-shead">
          <Eyebrow>{solution.eyebrow}</Eyebrow>
          <h2 class="font-serif text-h6 font-normal text-black">
            {solution.headingLead}<span class="text-brand"
              >{solution.headingAccent}</span
            >
          </h2>
          <p class="max-w-[34ch] text-lg text-black">{solution.subheading}</p>
        </div>
      </div>
    </div>

    {/* ---- Cards — flow within the SAME panel beneath the header; no pin ------- */}
    <div data-hm-cards class="hm-cards">
      {
        metrics.map((m) => (
          <div data-hm-card data-open="false" class="hm-card group flex flex-col">
            <div class="hm-card-main">
              {/* Fills crossfade: grey (before) → white + gradient (after) */}
              <div class="hm-fill hm-fill--before" aria-hidden="true" />
              <div class="hm-fill hm-fill--after" aria-hidden="true" />

              {/* Reached-state link (Solution outcome → customer story). Icon
                  cards have no link, so it's only rendered for a stat href. */}
              {m.after.href && (
                <a
                  class="hm-card-link"
                  href={m.after.href}
                  aria-label={m.after.label}
                />
              )}

              <div class="hm-card-body">
                {/* Top affordance: info "i" (before) crossfades to the arrow (a
                    stat card's link cue) or, for an icon card, to its icon disc —
                    which sits here, level with the stat cards' arrow. */}
                <div class="hm-top">
                  {m.before.detail ? (
                    <span class="hm-info">
                      <ArrowCircle
                        variant="dotted"
                        glyph="info"
                        label="Show the source for this figure"
                        data-hm-toggle
                        aria-expanded="false"
                        class="text-black"
                      />
                    </span>
                  ) : (
                    <span class="hm-info" aria-hidden="true" />
                  )}
                  {m.after.variant === "icon" ? (
                    <span class="hm-icon-disc" aria-hidden="true">
                      <span class="grid size-12 place-items-center rounded-full bg-purple-150 text-black">
                        <svg
                          viewBox="0 0 24 24"
                          fill="none"
                          stroke="currentColor"
                          stroke-width="1.5"
                          stroke-linecap="round"
                          stroke-linejoin="round"
                          class="size-8"
                          set:html={outcomeIcons[m.after.icon ?? ""] ?? ""}
                        />
                      </span>
                    </span>
                  ) : (
                    <span class="hm-arrow" aria-hidden="true">
                      <ArrowCircle variant="dotted" glyph="arrow" decorative />
                    </span>
                  )}
                </div>

                {/* Value — the stat number (before ↔ after). For an icon card the
                    after face is empty: its disc lives in the top row above, so
                    this slot just clears to spacing between disc and copy. */}
                <div class="hm-swap hm-value font-serif text-h4 font-normal">
                  <span class="hm-before text-gray-400">{m.before.value}</span>
                  <span class="hm-after text-black">
                    {m.after.variant === "icon" ? "" : m.after.value}
                  </span>
                </div>

                {/* Label — before ↔ after in the same slot. Icon cards render
                    their copy in the serif card style rather than the stat's
                    uppercase micro-label. */}
                <div class="hm-swap hm-label text-sm font-semibold uppercase">
                  <span class="hm-before max-w-[220px] text-gray-400">
                    {m.before.label}
                  </span>
                  {m.after.variant === "icon" ? (
                    <span class="hm-after max-w-[260px] font-serif text-2xl font-normal normal-case text-black">
                      {m.after.label}
                    </span>
                  ) : (
                    <span class="hm-after max-w-[220px] text-ink">
                      {m.after.label}
                    </span>
                  )}
                </div>
              </div>
            </div>

            {m.before.detail && (
              <div class="hm-source">
                <div
                  class={`hm-source-inner flex gap-2.5 rounded-[40px] bg-white px-8 py-10 text-left ${
                    m.before.detail.label.length <= 18
                      ? "items-center"
                      : "items-start"
                  }`}
                >
                  <span
                    class={`grid size-6 shrink-0 place-items-center text-black ${
                      m.before.detail.label.length <= 18 ? "" : "mt-px"
                    }`}
                    aria-hidden="true"
                  >
                    <svg viewBox="0 0 24 24" class="size-full" fill="none">
                      <circle
                        cx="12"
                        cy="12"
                        r="11.25"
                        stroke="currentColor"
                        stroke-width="1.5"
                        stroke-linecap="round"
                      />
                      <path
                        d="M12 16.5V11.5"
                        stroke="currentColor"
                        stroke-width="1.5"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                      />
                      <path
                        d="M12 8.01V8"
                        stroke="currentColor"
                        stroke-width="1.5"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                      />
                    </svg>
                  </span>
                  <a
                    href={m.before.detail.href}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="text-sm font-semibold uppercase text-black"
                  >
                    {m.before.detail.label}
                  </a>
                </div>
              </div>
            )}
          </div>
        ))
      }
    </div>
  </div>
</section>

<style>
  /* ---- Base = no-JS / reduced-motion: one normal-flow panel, all legible ---- */
  .hm-panel {
    position: relative;
    max-width: 460px;
    margin-inline: auto;
    border-radius: 40px;
    background-color: var(--color-purple-tint);
  }
  .hm-hero {
    position: relative;
  }
  /* The hero clips its own blooms to the rounded top; its square bottom lets the
     panel's purple continue seamlessly into the cards below (one panel). */
  .hm-hero-sticky {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 20px;
    padding: 80px 32px 32px;
    border-radius: 40px 40px 0 0;
    overflow: hidden;
  }
  .hm-bloom {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    pointer-events: none;
  }
  .hm-bloom--problem {
    opacity: 0;
  }
  .hm-problem {
    position: relative;
    z-index: 1;
    display: none; /* base: solution is the resting state */
    flex-direction: column;
    align-items: center;
    gap: 20px;
    text-align: center;
  }
  .hm-shead {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 20px;
    text-align: center;
  }
  .hm-cards {
    display: flex;
    flex-direction: column;
    gap: 16px;
    padding: 0 32px 40px;
  }

  /* Metric card — morphs from the Problem stat (before) to the Solution
     outcome (after) once reached: fill grey → white+gradient, info "i" → arrow,
     and value + label swap in the same slot. */
  .hm-card-main {
    position: relative;
    overflow: hidden;
    border-radius: 40px;
    border: 1px solid rgba(0, 0, 0, 0.15);
  }
  .hm-fill {
    position: absolute;
    inset: 0;
    transition: opacity 0.6s ease;
  }
  .hm-fill--before {
    background-color: rgba(220, 221, 228, 0.5);
  }
  .hm-fill--after {
    opacity: 0;
    background-color: #fff;
    background-image: var(--gradient-solution-card);
  }
  .hm-card[data-reached] .hm-fill--before {
    opacity: 0;
  }
  .hm-card[data-reached] .hm-fill--after {
    opacity: 1;
  }
  .hm-card-link {
    position: absolute;
    inset: 0;
    z-index: 3;
    pointer-events: none; /* only the reached (after) card links out */
  }
  .hm-card[data-reached] .hm-card-link {
    pointer-events: auto;
  }
  .hm-card-body {
    position: relative;
    z-index: 2;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 24px;
    padding: 40px 32px;
    text-align: center;
  }
  .hm-top {
    position: relative;
    width: 100%;
    height: 40px;
  }
  .hm-info,
  .hm-arrow {
    position: absolute;
    top: 0;
    transition: opacity 0.5s ease;
  }
  .hm-info {
    left: 50%;
    transform: translateX(-50%);
    z-index: 4; /* above the card link so the toggle stays clickable */
  }
  .hm-arrow {
    right: 0;
    opacity: 0;
    pointer-events: none;
  }
  .hm-card[data-reached] .hm-info {
    opacity: 0;
    pointer-events: none;
  }
  .hm-card[data-reached] .hm-arrow {
    opacity: 1;
  }
  /* Icon-card disc: sits in the top row (its top edge level with the arrow),
     centered, and crossfades in with the rest of the after state. It's 48px in
     the 40px row, so it overflows a touch into the gap below — intended. */
  .hm-icon-disc {
    position: absolute;
    top: 0;
    left: 50%;
    transform: translateX(-50%);
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.5s ease;
  }
  .hm-card[data-reached] .hm-icon-disc {
    opacity: 1;
  }
  @media (prefers-reduced-motion: reduce) {
    .hm-icon-disc {
      transition: none;
    }
  }
  /* Value / label: before + after stacked in one slot, crossfade + slide. */
  .hm-swap {
    display: grid;
    justify-items: center;
    width: 100%;
  }
  .hm-swap > span {
    grid-area: 1 / 1;
    text-align: center;
    transition:
      opacity 0.5s ease,
      transform 0.5s cubic-bezier(0.33, 1, 0.68, 1);
  }
  .hm-swap > .hm-after {
    opacity: 0;
    transform: translateY(16px);
  }
  .hm-card[data-reached] .hm-swap > .hm-before {
    opacity: 0;
    transform: translateY(-16px);
  }
  .hm-card[data-reached] .hm-swap > .hm-after {
    opacity: 1;
    transform: none;
  }
  .hm-card[data-reached] .hm-source {
    max-height: 0; /* source belongs to the before state */
  }
  @media (prefers-reduced-motion: reduce) {
    .hm-fill,
    .hm-info,
    .hm-arrow,
    .hm-swap > span {
      transition: none;
    }
  }

  /* Source citation: collapsed by default, revealed when the card opens. */
  .hm-source {
    max-height: 0;
    overflow: hidden;
    transition: max-height 0.55s cubic-bezier(0.33, 1, 0.68, 1);
  }
  .hm-source-inner {
    opacity: 0;
    transform: translateY(-10px);
    transition:
      opacity 0.45s ease 0.05s,
      transform 0.55s cubic-bezier(0.33, 1, 0.68, 1) 0.05s;
  }
  .hm-card[data-open="true"] .hm-source {
    max-height: 16rem;
  }
  .hm-card[data-open="true"] .hm-source-inner {
    opacity: 1;
    transform: translateY(0);
  }
  @media (prefers-reduced-motion: reduce) {
    .hm-source,
    .hm-source-inner {
      transition: none;
    }
    .hm-card[data-open="true"] .hm-source-inner {
      transform: none;
    }
  }

  /* ---- Enhanced = JS + motion + mobile/tablet ------------------------------- */
  @media (prefers-reduced-motion: no-preference) and (max-width: 1023px) {
    /* The hero is a bounded scroll track: its sticky child pins just long enough
       for the Problem → Solution crossfade, then RELEASES so the cards below flow
       with the page. No `overflow` on .hm-panel / .hm-hero, so sticky resolves
       against the viewport (not a clipped ancestor). */
    :global(html.js) .hm-hero {
      height: calc(100svh + 80vh);
    }
    :global(html.js) .hm-hero-sticky {
      position: sticky;
      top: 0;
      height: 100svh;
      padding: 40px 32px;
      /* Warms grey → purple through the crossfade (--hm-purple, set by JS). Its
         rounded top shows the card edge while pinned; the purple carries on into
         the cards once it scrolls away. The Problem "from" colour is an OPAQUE
         grey (--color-ink-wash 5% slate composited over --color-surface, i.e.
         #f0f0f1 — same as the desktop Problem panel) so it reads grey rather than
         letting the panel's purple-tint show through a translucent wash. */
      background-color: color-mix(
        in srgb,
        var(--color-purple-tint) calc(var(--hm-purple, 0) * 100%),
        #f0f0f1
      );
    }
    :global(html.js) .hm-bloom--problem {
      opacity: calc(1 - var(--hm-purple, 0));
    }
    :global(html.js) .hm-bloom--solution {
      opacity: var(--hm-purple, 0);
    }
    /* Problem + Solution header share the centred slot and crossfade in place. */
    :global(html.js) .hm-problem,
    :global(html.js) .hm-shead {
      position: absolute;
      inset: 0;
      z-index: 2;
      display: flex;
      justify-content: center;
      padding: 40px 32px;
    }
    :global(html.js) .hm-problem {
      pointer-events: none;
    }
    :global(html.js) .hm-shead {
      opacity: 0; /* fades in as the crossfade resolves */
    }
    /* Pull the cards up under the (centred) hero so they follow the header
       closely once it releases, instead of after the hero's empty lower half.
       The hero-sticky's opaque bg keeps them hidden until the pin lets go. */
    :global(html.js) .hm-cards {
      margin-top: -24vh;
    }
  }

  /* Phones: pin the header→cards gap to exactly 64px. The header is centred in
     the 100svh hero, so its released bottom sits ~50svh above the hero end; the
     `-50svh` term cancels that, leaving a fixed 64px + half-header offset that is
     independent of viewport height. (Tablet keeps the -24vh above — its wider
     header wraps shorter, and that spacing already reads right.) */
  @media (prefers-reduced-motion: no-preference) and (max-width: 767px) {
    :global(html.js) .hm-cards {
      margin-top: calc(269px - 50svh);
    }
  }

  /* Tablet ( md–lg ): the panel widens to sit 30px from each screen edge, rather
     than keeping the 460px cap it uses on phones. */
  @media (min-width: 768px) and (max-width: 1023px) {
    .handoff-mobile {
      padding-inline: 30px;
    }
    .hm-panel {
      max-width: none;
    }
  }
</style>

<script>
  function initHandoff(section: HTMLElement) {
    const enabled = () =>
      document.documentElement.classList.contains("js") &&
      window.matchMedia(
        "(prefers-reduced-motion: no-preference) and (max-width: 1023px)",
      ).matches;

    const panel = section.querySelector<HTMLElement>("[data-hm-panel]");
    const hero = section.querySelector<HTMLElement>(".hm-hero");
    const problem = section.querySelector<HTMLElement>("[data-hm-problem]");
    const shead = section.querySelector<HTMLElement>("[data-hm-shead]");
    const cardEls = Array.from(
      section.querySelectorAll<HTMLElement>("[data-hm-card]"),
    );
    if (!panel || !hero || !problem || !shead) return;

    const clamp01 = (x: number) => Math.min(1, Math.max(0, x));
    const easeOutCubic = (t: number) => 1 - Math.pow(1 - t, 3);
    const range = (p: number, a: number, b: number) => clamp01((p - a) / (b - a));
    const BLUR = 12;

    let ticking = false;
    const clear = () => {
      [problem, shead].forEach((l) => {
        l.style.opacity = "";
        l.style.filter = "";
      });
      panel.style.removeProperty("--hm-purple");
      cardEls.forEach((c) => {
        c.removeAttribute("data-reached");
        delete c.dataset.hmReached;
      });
    };

    const render = () => {
      ticking = false;
      if (!enabled()) {
        clear();
        return;
      }

      // Crossfade progress over the pinned hero (how far it has scrolled past the
      // top, normalised to its pin distance).
      const pin = hero.offsetHeight - window.innerHeight;
      const top = hero.getBoundingClientRect().top;
      const cp = pin > 0 ? clamp01(-top / pin) : top <= 0 ? 1 : 0;

      // Problem fades + blurs away; Solution header resolves out of a blur.
      const out = easeOutCubic(range(cp, 0.05, 0.5));
      problem.style.opacity = String(1 - out);
      problem.style.filter = `blur(${out * BLUR}px)`;

      const headIn = easeOutCubic(range(cp, 0.25, 0.8));
      shead.style.opacity = String(headIn);
      shead.style.filter = `blur(${(1 - headIn) * 8}px)`;

      // Hero warms grey → purple through the crossfade.
      panel.style.setProperty("--hm-purple", String(range(cp, 0.1, 0.6)));

      // Cards morph before → after as their centre crosses the viewport focus
      // line — driven by normal page scroll now (the cards are unpinned), so the
      // last card reaches it just like the rest.
      const line = window.innerHeight * 0.6;
      cardEls.forEach((card) => {
        const r = card.getBoundingClientRect();
        const reached = r.top + r.height / 2 < line;
        const was = card.dataset.hmReached === "1";
        if (reached && !was) {
          card.dataset.hmReached = "1";
          if (card.getAttribute("data-open") === "true") {
            // Close the open source first, then morph a beat later.
            card.setAttribute("data-open", "false");
            card
              .querySelector("[data-hm-toggle]")
              ?.setAttribute("aria-expanded", "false");
            window.setTimeout(() => {
              if (card.dataset.hmReached === "1")
                card.setAttribute("data-reached", "");
            }, 420);
          } else {
            card.setAttribute("data-reached", "");
          }
        } else if (!reached && was) {
          card.dataset.hmReached = "0";
          card.removeAttribute("data-reached");
        }
      });
    };

    const onScroll = () => {
      if (ticking) return;
      ticking = true;
      requestAnimationFrame(render);
    };

    // Info "i" toggles a card's source panel. Only one open at a time.
    const hmCards = Array.from(
      section.querySelectorAll<HTMLElement>("[data-hm-card]"),
    );
    section.querySelectorAll<HTMLButtonElement>("[data-hm-toggle]").forEach(
      (btn) => {
        btn.addEventListener("click", () => {
          const card = btn.closest<HTMLElement>("[data-hm-card]");
          if (!card) return;
          const open = card.getAttribute("data-open") === "true";
          hmCards.forEach((other) => {
            if (other !== card) {
              other.setAttribute("data-open", "false");
              other
                .querySelector<HTMLButtonElement>("[data-hm-toggle]")
                ?.setAttribute("aria-expanded", "false");
            }
          });
          card.setAttribute("data-open", open ? "false" : "true");
          btn.setAttribute("aria-expanded", open ? "false" : "true");
        });
      },
    );

    render();
    window.addEventListener("scroll", onScroll, { passive: true });
    window.addEventListener("resize", onScroll);
  }

  document
    .querySelectorAll<HTMLElement>("[data-handoff-mobile]")
    .forEach(initHandoff);
</script>
