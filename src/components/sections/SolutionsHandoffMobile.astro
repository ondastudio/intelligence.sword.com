---
/**
 * SolutionsHandoffMobile — the mobile + tablet ( < lg ) "Problem → Solution" beat,
 * as one pinned panel (Figma 9298:7482):
 *
 *   1. The panel opens on the Problem eyebrow + heading + text.
 *   2. Scrolling crossfades that (fade + blur, panel warming grey → purple)
 *      into the Solution eyebrow + heading + text, held in the same spot.
 *   3. Still pinned, the Solution content then scrolls up inside the panel to
 *      reveal the stat cards stacked below the header — each card's info "i"
 *      reveals its source citation.
 *
 * One panel, one section. Gated on JS + no-reduced-motion + mobile width;
 * without it the panel is normal flow (problem block, then the solution header
 * and cards), all legible. Content comes from src/data/solutions.json.
 */
import Eyebrow from "../ui/Eyebrow.astro";
import ArrowCircle from "../ui/ArrowCircle.astro";
import solutions from "../../data/solutions.json";

const { problem, solution } = solutions;

// Each card starts on its Problem stat (before) and, when reached, morphs into
// the matching Solution outcome (after) — number swapping in the same slot.
const metrics = problem.cards.map((p, i) => ({
  before: { value: p.value, label: p.label, detail: p.detail },
  after: {
    value: solution.cards[i].value,
    label: solution.cards[i].label,
    href: solution.cards[i].href,
  },
}));
---

<section data-handoff-mobile class="handoff-mobile bg-surface px-5 py-[120px]">
  <div class="hm-sticky">
    <div data-hm-panel class="hm-panel">
      {/* Background warms grey → purple via --hm-purple */}
      <div class="hm-purple-layer" aria-hidden="true"></div>
      <img
        data-hm-bloom="problem"
        src="/solutions/problem-bloom.svg"
        alt=""
        aria-hidden="true"
        class="hm-bloom hm-bloom--problem"
      />
      <img
        data-hm-bloom="solution"
        src="/solutions/solution-bloom.svg"
        alt=""
        aria-hidden="true"
        class="hm-bloom hm-bloom--solution"
      />

      {/* Problem — centred, crossfades out */}
      <div data-hm-problem class="hm-problem">
        <Eyebrow>{problem.eyebrow}</Eyebrow>
        <h2 class="font-serif text-h6 font-normal text-black">
          {problem.heading}
        </h2>
        <p class="max-w-[34ch] text-lg text-black">{problem.subheading}</p>
      </div>

      {/* Solution — header + cards; scrolls up inside the panel */}
      <div data-hm-track class="hm-track">
        <div data-hm-shead class="hm-shead">
          <Eyebrow>{solution.eyebrow}</Eyebrow>
          <h2 class="font-serif text-h6 font-normal text-black">
            {solution.headingLead}<span class="text-brand"
              >{solution.headingAccent}</span
            >
          </h2>
          <p class="max-w-[34ch] text-lg text-black">{solution.subheading}</p>
        </div>

        <div data-hm-cards class="hm-cards">
          {
            metrics.map((m) => (
              <div data-hm-card data-open="false" class="hm-card group flex flex-col">
                <div class="hm-card-main">
                  {/* Fills crossfade: grey (before) → white + gradient (after) */}
                  <div class="hm-fill hm-fill--before" aria-hidden="true" />
                  <div class="hm-fill hm-fill--after" aria-hidden="true" />

                  {/* Reached-state link (Solution outcome → customer story) */}
                  <a
                    class="hm-card-link"
                    href={m.after.href}
                    aria-label={m.after.label}
                  />

                  <div class="hm-card-body">
                    {/* Top affordance: info "i" (before) ↔ arrow (after) */}
                    <div class="hm-top">
                      {m.before.detail ? (
                        <span class="hm-info">
                          <ArrowCircle
                            variant="dotted"
                            glyph="info"
                            label="Show the source for this figure"
                            data-hm-toggle
                            aria-expanded="false"
                            class="text-black"
                          />
                        </span>
                      ) : (
                        <span class="hm-info" aria-hidden="true" />
                      )}
                      <span class="hm-arrow" aria-hidden="true">
                        <ArrowCircle variant="dotted" glyph="arrow" decorative />
                      </span>
                    </div>

                    {/* Value — before ↔ after in the same slot */}
                    <div class="hm-swap hm-value font-serif text-h4 font-normal">
                      <span class="hm-before text-gray-400">{m.before.value}</span>
                      <span class="hm-after text-black">{m.after.value}</span>
                    </div>

                    {/* Label — before ↔ after in the same slot */}
                    <div class="hm-swap hm-label text-sm font-semibold uppercase">
                      <span class="hm-before max-w-[220px] text-gray-400">
                        {m.before.label}
                      </span>
                      <span class="hm-after max-w-[220px] text-ink">
                        {m.after.label}
                      </span>
                    </div>
                  </div>
                </div>

                {m.before.detail && (
                  <div class="hm-source">
                    <div
                      class={`hm-source-inner flex gap-2.5 rounded-[40px] bg-white px-8 py-10 text-left ${
                        m.before.detail.label.length <= 18
                          ? "items-center"
                          : "items-start"
                      }`}
                    >
                      <span
                        class={`grid size-6 shrink-0 place-items-center text-black ${
                          m.before.detail.label.length <= 18 ? "" : "mt-px"
                        }`}
                        aria-hidden="true"
                      >
                        <svg viewBox="0 0 24 24" class="size-full" fill="none">
                          <circle
                            cx="12"
                            cy="12"
                            r="11.25"
                            stroke="currentColor"
                            stroke-width="1.5"
                            stroke-linecap="round"
                          />
                          <path
                            d="M12 16.5V11.5"
                            stroke="currentColor"
                            stroke-width="1.5"
                            stroke-linecap="round"
                            stroke-linejoin="round"
                          />
                          <path
                            d="M12 8.01V8"
                            stroke="currentColor"
                            stroke-width="1.5"
                            stroke-linecap="round"
                            stroke-linejoin="round"
                          />
                        </svg>
                      </span>
                      <a
                        href={m.before.detail.href}
                        target="_blank"
                        rel="noopener noreferrer"
                        class="text-sm font-semibold uppercase text-black"
                      >
                        {m.before.detail.label}
                      </a>
                    </div>
                  </div>
                )}
              </div>
            ))
          }
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  /* ---- Base = no-JS / reduced-motion / desktop: one normal-flow panel ------ */
  .hm-panel {
    position: relative;
    overflow: hidden;
    max-width: 460px;
    margin-inline: auto;
    border-radius: 40px;
    background-color: var(--color-purple-tint);
    padding: 80px 32px;
  }
  .hm-purple-layer {
    position: absolute;
    inset: 0;
    background-color: var(--color-purple-tint);
    opacity: 0;
  }
  .hm-bloom {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    pointer-events: none;
  }
  .hm-bloom--problem {
    opacity: 0;
  }
  .hm-problem {
    position: relative;
    z-index: 1;
    display: none; /* base: solution is the resting state */
    flex-direction: column;
    align-items: center;
    gap: 20px;
    text-align: center;
  }
  .hm-track {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    gap: 64px;
  }
  .hm-shead {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 20px;
    text-align: center;
  }
  .hm-cards {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  /* Metric card — morphs from the Problem stat (before) to the Solution
     outcome (after) once reached: fill grey → white+gradient, info "i" → arrow,
     and value + label swap in the same slot. */
  .hm-card-main {
    position: relative;
    overflow: hidden;
    border-radius: 40px;
    border: 1px solid rgba(0, 0, 0, 0.15);
  }
  .hm-fill {
    position: absolute;
    inset: 0;
    transition: opacity 0.6s ease;
  }
  .hm-fill--before {
    background-color: rgba(220, 221, 228, 0.5);
  }
  .hm-fill--after {
    opacity: 0;
    background-color: #fff;
    background-image: var(--gradient-solution-card);
  }
  .hm-card[data-reached] .hm-fill--before {
    opacity: 0;
  }
  .hm-card[data-reached] .hm-fill--after {
    opacity: 1;
  }
  .hm-card-link {
    position: absolute;
    inset: 0;
    z-index: 3;
    pointer-events: none; /* only the reached (after) card links out */
  }
  .hm-card[data-reached] .hm-card-link {
    pointer-events: auto;
  }
  .hm-card-body {
    position: relative;
    z-index: 2;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 24px;
    padding: 40px 32px;
    text-align: center;
  }
  .hm-top {
    position: relative;
    width: 100%;
    height: 40px;
  }
  .hm-info,
  .hm-arrow {
    position: absolute;
    top: 0;
    transition: opacity 0.5s ease;
  }
  .hm-info {
    left: 50%;
    transform: translateX(-50%);
    z-index: 4; /* above the card link so the toggle stays clickable */
  }
  .hm-arrow {
    right: 0;
    opacity: 0;
    pointer-events: none;
  }
  .hm-card[data-reached] .hm-info {
    opacity: 0;
    pointer-events: none;
  }
  .hm-card[data-reached] .hm-arrow {
    opacity: 1;
  }
  /* Value / label: before + after stacked in one slot, crossfade + slide. */
  .hm-swap {
    display: grid;
    justify-items: center;
    width: 100%;
  }
  .hm-swap > span {
    grid-area: 1 / 1;
    text-align: center;
    transition:
      opacity 0.5s ease,
      transform 0.5s cubic-bezier(0.33, 1, 0.68, 1);
  }
  .hm-swap > .hm-after {
    opacity: 0;
    transform: translateY(16px);
  }
  .hm-card[data-reached] .hm-swap > .hm-before {
    opacity: 0;
    transform: translateY(-16px);
  }
  .hm-card[data-reached] .hm-swap > .hm-after {
    opacity: 1;
    transform: none;
  }
  .hm-card[data-reached] .hm-source {
    max-height: 0; /* source belongs to the before state */
  }
  @media (prefers-reduced-motion: reduce) {
    .hm-fill,
    .hm-info,
    .hm-arrow,
    .hm-swap > span {
      transition: none;
    }
  }

  /* Source citation: collapsed by default, revealed when the card opens. */
  .hm-source {
    max-height: 0;
    overflow: hidden;
    transition: max-height 0.55s cubic-bezier(0.33, 1, 0.68, 1);
  }
  .hm-source-inner {
    opacity: 0;
    transform: translateY(-10px);
    transition:
      opacity 0.45s ease 0.05s,
      transform 0.55s cubic-bezier(0.33, 1, 0.68, 1) 0.05s;
  }
  .hm-card[data-open="true"] .hm-source {
    max-height: 16rem;
  }
  .hm-card[data-open="true"] .hm-source-inner {
    opacity: 1;
    transform: translateY(0);
  }
  @media (prefers-reduced-motion: reduce) {
    .hm-source,
    .hm-source-inner {
      transition: none;
    }
    .hm-card[data-open="true"] .hm-source-inner {
      transform: none;
    }
  }

  /* ---- Enhanced = JS + motion + mobile/tablet: pin, crossfade, scroll cards up ---- */
  @media (prefers-reduced-motion: no-preference) and (max-width: 1023px) {
    :global(html.js) .handoff-mobile {
      height: calc(100svh + 280vh);
      padding-block: 0;
    }
    :global(html.js) .hm-sticky {
      position: sticky;
      top: 0;
      display: flex;
      align-items: center;
      min-height: 100svh;
      padding-block: 16px;
    }
    :global(html.js) .hm-panel {
      width: 100%;
      max-width: 460px;
      height: 84svh;
      padding: 0;
      background-color: color-mix(
        in srgb,
        var(--color-purple-tint) calc(var(--hm-purple, 0) * 100%),
        var(--color-ink-wash)
      );
    }
    :global(html.js) .hm-bloom--problem {
      opacity: calc(1 - var(--hm-purple, 0));
    }
    :global(html.js) .hm-bloom--solution {
      opacity: var(--hm-purple, 0);
    }
    /* Problem is a centred overlay that fades out. */
    :global(html.js) .hm-problem {
      display: flex;
      position: absolute;
      inset: 0;
      z-index: 2;
      justify-content: center;
      padding: 40px 32px;
      pointer-events: none;
    }
    /* Solution content is a track pinned to the panel top, translated by JS. */
    :global(html.js) .hm-track {
      position: absolute;
      inset-inline: 0;
      top: 0;
      /* Extra bottom room so the last card can scroll up past the focus line
         (otherwise it rests at the panel base and never morphs). */
      padding: 40px 32px 80px;
      gap: 40px;
      will-change: transform;
    }
    :global(html.js) .hm-shead {
      opacity: 0;
    }
  }

  /* Tablet ( md–lg ): the card widens to sit 30px from each screen edge, rather
     than keeping the 460px cap it uses on phones. */
  @media (min-width: 768px) and (max-width: 1023px) {
    .handoff-mobile {
      padding-inline: 30px;
    }
    .hm-panel,
    :global(html.js) .hm-panel {
      max-width: none;
    }
  }
</style>

<script>
  function initHandoff(section: HTMLElement) {
    const enabled = () =>
      document.documentElement.classList.contains("js") &&
      window.matchMedia(
        "(prefers-reduced-motion: no-preference) and (max-width: 1023px)",
      ).matches;

    const panel = section.querySelector<HTMLElement>("[data-hm-panel]");
    const problem = section.querySelector<HTMLElement>("[data-hm-problem]");
    const track = section.querySelector<HTMLElement>("[data-hm-track]");
    const shead = section.querySelector<HTMLElement>("[data-hm-shead]");
    const cards = section.querySelector<HTMLElement>("[data-hm-cards]");
    const cardEls = Array.from(
      section.querySelectorAll<HTMLElement>("[data-hm-card]"),
    );
    if (!panel || !problem || !track || !shead || !cards) return;

    const clamp01 = (x: number) => Math.min(1, Math.max(0, x));
    const easeOutCubic = (t: number) => 1 - Math.pow(1 - t, 3);
    const range = (p: number, a: number, b: number) => clamp01((p - a) / (b - a));
    const BLUR = 12;

    let ticking = false;
    const clear = () => {
      [problem, shead].forEach((l) => {
        l.style.opacity = "";
        l.style.filter = "";
      });
      cards.style.opacity = "";
      cards.style.pointerEvents = "";
      cardEls.forEach((c) => {
        c.removeAttribute("data-reached");
        delete c.dataset.hmReached;
      });
      track.style.transform = "";
      panel.style.removeProperty("--hm-purple");
    };

    const render = () => {
      ticking = false;
      if (!enabled()) {
        clear();
        return;
      }
      const scrub = section.offsetHeight - window.innerHeight;
      const p =
        scrub > 0 ? clamp01(-section.getBoundingClientRect().top / scrub) : 0;

      // 1. Problem → Solution header crossfade (fade + blur, panel warming).
      const out = easeOutCubic(range(p, 0.04, 0.24));
      problem.style.opacity = String(1 - out);
      problem.style.filter = `blur(${out * BLUR}px)`;

      const headIn = easeOutCubic(range(p, 0.14, 0.42));
      shead.style.opacity = String(headIn);
      shead.style.filter = `blur(${(1 - headIn) * 8}px)`;

      panel.style.setProperty("--hm-purple", String(range(p, 0.1, 0.5)));

      // Cards stay hidden until the crossfade to Solution is done — the Problem
      // overlay is transparent, so an ungated card would show through behind it.
      const reveal = range(p, 0.24, 0.34);
      cards.style.opacity = String(reveal);
      cards.style.pointerEvents = reveal > 0.5 ? "auto" : "none";

      // 2. Scroll the Solution track up inside the panel to reveal the cards.
      const panelH = panel.clientHeight;
      const headH = shead.offsetHeight;
      const trackH = track.scrollHeight;
      const startY = (panelH - headH) / 2 - 40; // header centred (minus top pad)
      const endY = Math.min(startY, panelH - trackH); // last card resting at base
      const sp = range(p, 0.28, 1);
      track.style.transform = `translate3d(0, ${startY + (endY - startY) * sp}px, 0)`;

      // 3. Each card morphs before → after once it's scrolled up past the panel
      //    focus line — the number swaps in the same slot.
      const panelRect = panel.getBoundingClientRect();
      const line = panelRect.top + panelH * 0.56;
      const last = cardEls.length - 1;
      cardEls.forEach((card, i) => {
        const r = card.getBoundingClientRect();
        // Cards morph as their centre crosses the focus line. The last card
        // rests near the panel base (80px bottom) and can't reach that line, so
        // it morphs once it has fully settled into view instead.
        const reached =
          r.top + r.height / 2 < line ||
          (i === last && r.bottom < panelRect.bottom - 24);
        const was = card.dataset.hmReached === "1";
        if (reached && !was) {
          card.dataset.hmReached = "1";
          if (card.getAttribute("data-open") === "true") {
            // Close the open source first, then morph a beat later.
            card.setAttribute("data-open", "false");
            card
              .querySelector("[data-hm-toggle]")
              ?.setAttribute("aria-expanded", "false");
            window.setTimeout(() => {
              if (card.dataset.hmReached === "1")
                card.setAttribute("data-reached", "");
            }, 420);
          } else {
            card.setAttribute("data-reached", "");
          }
        } else if (!reached && was) {
          card.dataset.hmReached = "0";
          card.removeAttribute("data-reached");
        }
      });
    };

    const onScroll = () => {
      if (ticking) return;
      ticking = true;
      requestAnimationFrame(render);
    };

    // Info "i" toggles a card's source panel. The track grows/shrinks as the
    // source expands; a ResizeObserver re-runs render() through the whole
    // animation so endY (and the scroll) track the new height — otherwise the
    // last card's freshly opened source would be clipped at the panel bottom.
    const hmCards = Array.from(
      section.querySelectorAll<HTMLElement>("[data-hm-card]"),
    );
    section.querySelectorAll<HTMLButtonElement>("[data-hm-toggle]").forEach(
      (btn) => {
        btn.addEventListener("click", () => {
          const card = btn.closest<HTMLElement>("[data-hm-card]");
          if (!card) return;
          const open = card.getAttribute("data-open") === "true";
          // Only one source open at a time — opening one closes the others.
          hmCards.forEach((other) => {
            if (other !== card) {
              other.setAttribute("data-open", "false");
              other
                .querySelector<HTMLButtonElement>("[data-hm-toggle]")
                ?.setAttribute("aria-expanded", "false");
            }
          });
          card.setAttribute("data-open", open ? "false" : "true");
          btn.setAttribute("aria-expanded", open ? "false" : "true");
        });
      },
    );

    render();
    new ResizeObserver(onScroll).observe(track);
    window.addEventListener("scroll", onScroll, { passive: true });
    window.addEventListener("resize", onScroll);
  }

  document
    .querySelectorAll<HTMLElement>("[data-handoff-mobile]")
    .forEach(initHandoff);
</script>
