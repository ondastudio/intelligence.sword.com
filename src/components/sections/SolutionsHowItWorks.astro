<script>
  // The How-it-works stepper runs in one of two modes (like the homepage Care
  // Orchestration cards):
  //  • pinned (lg + motion allowed): the stage sticks and continued scroll is
  //    scrubbed into one segment per step — the active step advances as you
  //    scroll, panels crossfading in place (no horizontal slide). The icon navbar
  //    stays in sync; clicking an icon smooth-scrolls to that step's segment.
  //  • static (below lg, or reduced motion): no pin — the plain click stepper;
  //    clicking / arrow-keying a tab swaps the active step directly.
  function initHowItWorks(section: HTMLElement) {
    const track = section.querySelector<HTMLElement>("[data-hiw-track]");
    const stage = section.querySelector<HTMLElement>("[data-hiw-stage]");
    const stack = section.querySelector<HTMLElement>(".hiw-stack");
    // Swirl bloom layer (its sticky stage + the absolute containing block around
    // it) — kept in sync with the pin below so the bloom doesn't drift early.
    const swirlStage = section.querySelector<HTMLElement>(
      "[data-hiw-swirl-stage]",
    );
    const swirlLayer = swirlStage?.parentElement ?? null;
    const tabs = Array.from(
      section.querySelectorAll<HTMLButtonElement>("[data-step-btn]"),
    );
    const panels = Array.from(
      section.querySelectorAll<HTMLElement>("[data-step-panel]"),
    );
    if (!tabs.length || !track || !stage || !stack) return;

    // Enhance: co-render every panel and drive the active step via `.is-active`
    // instead of the `[hidden]` attribute, so the panels can crossfade over each
    // other (see the CSS note — `[hidden]` would collapse them to display:none).
    stack.classList.add("is-enhanced");
    panels.forEach((panel) => panel.removeAttribute("hidden"));

    const N = tabs.length;
    const clamp = (n: number, lo: number, hi: number) =>
      Math.min(hi, Math.max(lo, n));
    const reduceMotion = window.matchMedia(
      "(prefers-reduced-motion: reduce)",
    ).matches;
    const lgMQ = window.matchMedia("(min-width: 1024px)");

    // Active step. `select` only mutates the DOM when the step actually changes
    // so the crossfade isn't re-triggered every scroll frame.
    let active = -1;
    const select = (index: number) => {
      index = clamp(index, 0, N - 1);
      if (index === active) return;
      active = index;
      tabs.forEach((tab, i) =>
        tab.setAttribute("aria-selected", i === index ? "true" : "false"),
      );
      panels.forEach((panel, i) => {
        // `.is-active` drives the crossfade (via CSS); `aria-hidden` mirrors it
        // in the a11y tree. Every panel stays `display: flex` in the shared grid
        // cell so the area stays sized to the tallest step.
        const on = i === index;
        panel.classList.toggle("is-active", on);
        panel.setAttribute("aria-hidden", on ? "false" : "true");
      });
    };

    // --- Pin geometry (recomputed on resize / breakpoint change) -------------
    let pinned = false;
    let segPx = 0; // scroll px each step segment is scrubbed across
    let scrub = 0; // total pinned scroll distance
    let stickTop = 0; // sticky `top` that lands the stage vertically centred
    let ticking = false;

    const measure = () => {
      section.classList.remove("is-pinned");
      track.style.height = "";
      stage.style.top = "";
      stage.style.transform = "";
      stage.style.transformOrigin = "";
      if (swirlLayer) {
        swirlLayer.style.height = "";
        swirlLayer.style.bottom = "";
      }
      // Pin on every breakpoint (mobile included) so scrolling is scrubbed
      // through all five steps — you can't skip past the section without seeing
      // each card. Only reduced-motion opts out to the plain click stepper.
      pinned = !reduceMotion;
      if (!pinned) return;
      const vh = window.innerHeight;
      // Scroll distance each step dwells for; larger = more scroll per step.
      segPx = Math.round(vh * 0.85);
      scrub = N * segPx;
      const minTop = 24;
      const stageH = stage.offsetHeight;
      // Scale the stage down to fit shorter viewports (keeping Figma proportions)
      // so the whole card stays visible while pinned rather than overflowing.
      const fitScale = Math.min(1, (vh - minTop * 2) / stageH);
      stage.style.transformOrigin = "top center";
      stage.style.transform = fitScale < 1 ? `scale(${fitScale})` : "";
      const scaledH = stageH * fitScale;
      stickTop = Math.max(minTop, Math.round((vh - scaledH) / 2));
      stage.style.top = `${stickTop}px`;
      section.classList.add("is-pinned");
      track.style.height = `${stageH + scrub}px`;

      // Keep the swirl bloom pinned in sync with the cards. On its own the swirl
      // is a plain `sticky top:0`, so it detaches from the viewport one swirl-
      // height before its containing block ends — which, with the tall pinned
      // track, lands midway through the LAST step and makes the bloom drift while
      // the final card is still on screen. Extend the sticky containing block so
      // the swirl only releases once the cards unpin (the raw===1 scroll point,
      // plus any fit-scale slack), so the bloom stays put behind every step and
      // lets go together with the stack.
      if (swirlLayer && swirlStage) {
        const secTop = section.getBoundingClientRect().top + window.scrollY;
        const trackTop = track.getBoundingClientRect().top + window.scrollY;
        const trackOffset = trackTop - secTop; // header height above the track
        const swirlH = swirlStage.offsetHeight;
        swirlLayer.style.bottom = "auto";
        swirlLayer.style.height = `${Math.round(
          trackOffset + scrub - stickTop + (stageH - scaledH) + swirlH,
        )}px`;
      }
    };

    const render = () => {
      ticking = false;
      if (!pinned) return;
      // The stage sticks at top:stickTop and holds for `scrub` px; track top runs
      // stickTop → stickTop − scrub across that span. Map it to an equal segment
      // per step.
      const raw = (stickTop - track.getBoundingClientRect().top) / scrub;
      select(clamp(Math.floor(clamp(raw, 0, 1) * N), 0, N - 1));
    };

    const onScroll = () => {
      if (ticking) return;
      ticking = true;
      requestAnimationFrame(render);
    };

    // --- Eased scroll tween for nav clicks -----------------------------------
    // Native `behavior:"smooth"` snaps too fast when a click spans several
    // segments; tweening over an eased, distance-scaled duration glides the step
    // scrubbing in at a steady pace. A manual wheel/touch cancels it.
    const easeOutQuint = (t: number) => 1 - Math.pow(1 - t, 5);
    let scrollAnim = 0;
    const cancelScrollTween = () => {
      if (scrollAnim) {
        cancelAnimationFrame(scrollAnim);
        scrollAnim = 0;
      }
    };
    const smoothScrollTo = (target: number) => {
      cancelScrollTween();
      const start = window.scrollY;
      const dist = target - start;
      if (Math.abs(dist) < 1) return;
      const segments = segPx ? Math.abs(dist) / segPx : 1;
      const duration = Math.min(2000, Math.max(700, 520 * segments));
      const startTime = performance.now();
      const stepTween = (now: number) => {
        const t = Math.min(1, (now - startTime) / duration);
        window.scrollTo(0, start + dist * easeOutQuint(t));
        scrollAnim = t < 1 ? requestAnimationFrame(stepTween) : 0;
      };
      scrollAnim = requestAnimationFrame(stepTween);
    };
    window.addEventListener("wheel", cancelScrollTween, { passive: true });
    window.addEventListener("touchstart", cancelScrollTween, { passive: true });

    // Scroll to a step's segment centre (only meaningful while pinned).
    const scrollToStep = (i: number) => {
      const trackTop = window.scrollY + track.getBoundingClientRect().top;
      smoothScrollTo(trackTop - stickTop + (clamp(i, 0, N - 1) + 0.5) * segPx);
    };

    const goTo = (i: number) => {
      if (pinned) scrollToStep(i);
      else select(i);
    };

    tabs.forEach((tab, i) => {
      tab.addEventListener("click", () => goTo(i));
      // Roving arrow-key navigation across the tablist.
      tab.addEventListener("keydown", (e) => {
        if (
          e.key !== "ArrowDown" &&
          e.key !== "ArrowRight" &&
          e.key !== "ArrowUp" &&
          e.key !== "ArrowLeft"
        )
          return;
        e.preventDefault();
        const dir = e.key === "ArrowDown" || e.key === "ArrowRight" ? 1 : -1;
        const next = (Math.max(0, active) + dir + N) % N;
        goTo(next);
        tabs[next].focus();
      });
    });

    // Mobile prev/next arrows step through the panels (clamped at the ends).
    section
      .querySelector<HTMLButtonElement>("[data-hiw-prev]")
      ?.addEventListener("click", () => goTo(Math.max(0, active) - 1));
    section
      .querySelector<HTMLButtonElement>("[data-hiw-next]")
      ?.addEventListener("click", () => goTo(Math.max(0, active) + 1));

    const onResize = () => {
      measure();
      render();
    };

    select(0);
    measure();
    render();
    window.addEventListener("scroll", onScroll, { passive: true });
    window.addEventListener("resize", onResize);
    lgMQ.addEventListener("change", onResize);
  }

  document
    .querySelectorAll<HTMLElement>("[data-howitworks]")
    .forEach(initHowItWorks);
</script>

<style>
  /* All panels occupy the same grid cell so the area sizes to the tallest step
     and the active one crossfades over the inactive ones — no layout jump on
     switch. Inactive panels keep their box (forced `display`) so the grid stays
     sized to the tallest step; `[hidden]` only fades + de-activates them. */
  /* All panels share the one grid cell so the area sizes to the tallest step.
     Without JS, Tailwind's preflight collapses the `[hidden]` panels
     (display:none !important) and only the first shows — a fine static fallback. */
  .hiw-stack > .hiw-panel {
    grid-area: 1 / 1;
  }

  /* Enhanced (JS) mode: the script strips `[hidden]` and drives the active step
     via `.is-active`, so every panel stays rendered in the shared cell. We avoid
     `[hidden]` here on purpose — Tailwind's `[hidden] { display:none !important }`
     (in @layer base) would collapse inactive panels and defeat the fade, and an
     unlayered `!important` can't beat a layered one.

     The swap is SEQUENTIAL, not a true crossfade: the outgoing panel fades fully
     out first, then the incoming one fades in after that. A simultaneous crossfade
     leaves both panels at ~50% opacity mid-transition, and because they share one
     grid cell (and the text columns have no background) the old step ghosts through
     the new one. Staggering the two fades means only one panel is ever visible, so
     there's no see-through double exposure. */
  .hiw-stack.is-enhanced {
    --hiw-fade: 0.42s;
  }
  .hiw-stack.is-enhanced > .hiw-panel {
    display: flex;
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
    /* Fade out immediately; hide once faded. */
    transition:
      opacity var(--hiw-fade) ease-in,
      visibility 0s linear var(--hiw-fade);
  }
  .hiw-stack.is-enhanced > .hiw-panel.is-active {
    opacity: 1;
    visibility: visible;
    pointer-events: auto;
    /* Fade in only after the outgoing panel has finished fading out. */
    transition:
      opacity var(--hiw-fade) ease-out var(--hiw-fade),
      visibility 0s linear 0s;
  }

  @media (prefers-reduced-motion: reduce) {
    .hiw-stack.is-enhanced > .hiw-panel {
      transition: none;
    }
  }

  /* Pin: on lg + motion the stage sticks while vertical scroll is scrubbed into
     one segment per step (JS drives the active step against the pinned progress,
     panels crossfade in place — no horizontal slide). The stage stays in normal
     flow until it sticks; JS sets `top` so it lands vertically centred, the track
     height (taller than the viewport) reserves the scrub distance, and is-pinned
     turns the sticky on. `overflow-x: clip` on the section clips horizontally
     without creating a scroll container, so this sticky resolves to the viewport.
     Off is-pinned (below lg / reduced motion) the stage is static — the plain
     click stepper. */
  [data-howitworks].is-pinned .hiw-stage {
    position: sticky;
  }

  /* Purple swirl bloom layer — spans from the header down through the stepper
     cards. A large elliptical mask keeps it a soft bloom that invades the card
     area and fades to the surface at the edges. */
  .hiw-swirl {
    height: clamp(760px, 100vw, 1200px);
    -webkit-mask-image: radial-gradient(
      72% 62% at 50% 48%,
      #000 0%,
      #000 26%,
      transparent 74%
    );
    mask-image: radial-gradient(
      72% 62% at 50% 48%,
      #000 0%,
      #000 26%,
      transparent 74%
    );
  }
</style>

<script>
  // Animated purple swirl bloom behind the "Enroll. Coach. Prepare. Recover."
  // headline — the shared hero swirl recoloured to the soft-purple palette
  // (body ~#bda4ff, highlights from the purple-100 / tint tokens).
  import { initSwirl } from "../../lib/swirl";

  const stage = document.querySelector<HTMLElement>("[data-hiw-swirl-stage]");
  const canvas = stage?.querySelector<HTMLCanvasElement>(
    "canvas[data-hiw-swirl]",
  );

  if (stage && canvas) {
    initSwirl(canvas, stage, {
      grainUrl: "/hero/swirl/perlin1.png",
      circular: true,
      warp: 0.7, // cohesive, rounded blob with a filled centre
      speed: 2.2,
      falloffStart: 0.5, // keep the centre filled; only the outer edge fades out
      falloffEnd: 0.92,
      colors: {
        bgColor: [0.976, 0.969, 1.0], // outer field — near-white with a faint lilac
        soft: [0.882, 0.839, 1.0], // inner highlight — purple-100 (#e1d6ff)
        body: [0.741, 0.643, 1.0], // dominant bloom — soft purple (~#bda4ff)
        lavender: [0.933, 0.91, 1.0], // secondary highlight — purple-tint
        crest: [0.97, 0.97, 0.97], // gradient crest — white
      },
    });
    requestAnimationFrame(() => canvas.classList.remove("opacity-0"));
  }
</script>
