// Line glyphs for the "AI+Human coaching journey" timeline cards.
const journeyIcons: Record<string, string> = {
  "bubble-chat": icons["bubble-chat"],
  phone: `<path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.13.96.36 1.9.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.91.34 1.85.57 2.81.7A2 2 0 0 1 22 16.92Z"/>`,
  check: `<path d="M20 6 9 17l-5-5"/>`,
  logout: `<path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/><path d="m16 17 5-5-5-5"/><path d="M21 12H9"/>`,
  pill: `<path d="m10.5 20.5 10-10a4.95 4.95 0 1 0-7-7l-10 10a4.95 4.95 0 1 0 7 7Z"/><path d="m8.5 8.5 7 7"/>`,
  route: `<circle cx="6" cy="19" r="3"/><path d="M9 19h8.5a3.5 3.5 0 0 0 0-7h-11a3.5 3.5 0 0 1 0-7H15"/><circle cx="18" cy="5" r="3"/>`,
  "home-10": icons["home-10"],
};

// Authentic iOS app-icon glyphs for the channel-preference tiles ("Hyper-
// personalized interactions" card) — Messages bubble, Phone handset, Mail
// envelope, sliced straight from the Figma export so they match 1:1. Each keeps
// its own (non-24²) viewBox since the paths live in the export's coordinate
// space; rendered in `currentColor` (white) on the coloured gradient tile.
const channelIcons: Record<string, { viewBox: string; path: string }> = {
  sms: {
    viewBox: "68.45 169.61 12.74 12.74",
    path: `<path d="M74.8322 171.871C73.6107 171.871 72.4393 172.275 71.5755 172.995C70.7118 173.714 70.2266 174.69 70.2266 175.707C70.2277 176.369 70.4343 177.019 70.8264 177.595C71.2184 178.171 71.7826 178.652 72.464 178.992C72.2825 179.398 72.0103 179.779 71.6587 180.119C72.3406 180 72.9807 179.748 73.5293 179.385C73.9522 179.489 74.391 179.543 74.8322 179.543C76.0537 179.543 77.2251 179.139 78.0889 178.42C78.9526 177.7 79.4378 176.725 79.4378 175.707C79.4378 174.69 78.9526 173.714 78.0889 172.995C77.2251 172.275 76.0537 171.871 74.8322 171.871Z"/>`,
  },
  call: {
    viewBox: "68.45 214.10 12.74 12.74",
    path: `<path d="M71.1479 219.602C70.6495 218.695 70.4531 217.955 70.4531 217.457C70.4531 216.958 70.574 216.823 70.6948 216.702C70.8156 216.581 71.3745 216.249 71.4802 216.173C71.5708 216.113 71.9333 215.977 72.1599 216.309C72.3865 216.641 72.8094 217.291 73.1115 217.729C73.5797 218.348 73.2021 218.62 73.0812 218.786C72.8547 219.088 72.7339 219.164 72.7339 219.526C72.7339 219.889 73.7609 220.946 74.0026 221.203C74.2443 221.46 75.2714 222.351 75.5885 222.411C75.9057 222.456 76.3437 222.124 76.4344 222.033C76.9026 221.671 77.1594 221.943 77.3708 222.064C77.5823 222.185 78.549 222.789 78.851 222.985C79.138 223.181 79.1078 223.499 79.1078 223.499C79.1078 223.499 78.9115 224.088 78.4583 224.526C78.3526 224.631 78.1562 224.767 77.688 224.767C77.2198 224.767 76.7062 224.677 75.4979 224.012C74.5161 223.468 73.5797 222.623 73.0812 222.124C72.5828 221.641 71.7219 220.644 71.1479 219.602Z"/>`,
  },
  email: {
    viewBox: "68.45 258.59 12.74 12.74",
    path: `<path fill-rule="evenodd" clip-rule="evenodd" d="M71.2625 262.215C71.1954 262.215 71.1321 262.226 71.0723 262.25L72.2709 263.484L73.4828 264.74L73.5049 264.767L73.5403 264.802L73.5757 264.838L73.6465 264.913L74.6858 265.979C74.7032 265.99 74.7533 266.036 74.7925 266.056C74.843 266.081 74.8977 266.104 74.954 266.106C75.0149 266.108 75.0771 266.091 75.1318 266.064C75.1728 266.044 75.1911 266.016 75.2387 265.979L76.4418 264.736L77.6581 263.484L78.8302 262.277C78.7549 262.236 78.6716 262.215 78.5825 262.215H71.2625ZM70.8954 262.365C70.7676 262.486 70.6875 262.668 70.6875 262.874V266.925C70.6875 267.092 70.7409 267.243 70.829 267.359L70.9971 267.2L72.2488 265.983L73.359 264.908L73.3368 264.882L72.1205 263.63L70.9042 262.374L70.8954 262.365ZM78.9894 262.405L77.804 263.63L76.5921 264.882L76.57 264.904L77.7244 266.023L78.9761 267.239L79.0513 267.31C79.1187 267.202 79.1575 267.069 79.1575 266.925V262.874C79.1575 262.691 79.094 262.525 78.9894 262.405ZM73.5005 265.054L72.3948 266.129L71.1386 267.345L70.9794 267.5C71.0634 267.554 71.1589 267.589 71.2625 267.589H78.5825C78.707 267.589 78.82 267.541 78.9142 267.465L78.8346 267.385L77.5785 266.169L76.4241 265.054L75.3847 266.125C75.3284 266.162 75.2908 266.203 75.2359 266.229C75.1475 266.27 75.0506 266.304 74.9532 266.303C74.8556 266.301 74.7598 266.263 74.6722 266.22C74.6282 266.198 74.6048 266.177 74.5532 266.134L73.5005 265.054Z"/>`,
  },
};
// Tile gradient per channel — iOS-style app icons (Messages/Phone green, Mail
// cyan→blue), matching the Figma export. See @theme tokens in global.css.
const channelTile: Record<string, string> = {
  sms: "bg-gradient-to-b from-imessage-100 to-imessage-600",
  call: "bg-gradient-to-b from-imessage-100 to-imessage-600",
  email: "bg-gradient-to-b from-mail-600 to-mail-100",
};
---

<section
  data-howitworks
  class="relative overflow-x-clip bg-surface text-black"
>
  {/* Purple swirl bloom behind the header — the shared hero swirl recoloured to
      the soft-purple palette (same as TriageCta). Sits at z-0 below the content
      (z-10); a radial mask keeps it a contained bloom around the headline.
      The outer layer spans the whole (now tall, pinned) section without taking
      layout space; the inner stage is `sticky` so the bloom stays in view behind
      the pinned cards as the steps scrub, rather than scrolling off with the
      section top. It releases at the section's bottom, so it never bleeds into
      the next section. */}
  <div aria-hidden="true" class="pointer-events-none absolute inset-0 z-0">
    <div
      data-hiw-swirl-stage
      class="hiw-swirl lg:sticky lg:top-0"
    >
      <canvas
        data-hiw-swirl
        class="absolute inset-0 h-full w-full opacity-0 transition-opacity duration-700"
      ></canvas>
    </div>
  </div>

  <div
    class="relative z-10 mx-auto flex w-full max-w-[1440px] flex-col items-center gap-[clamp(3rem,8vw,80px)] px-4 pb-[clamp(5rem,12vw,120px)] pt-[clamp(5rem,14vw,200px)] md:px-8"
  >
    {/* ---- Header --------------------------------------------------------- */}
    <header class="flex flex-col items-center gap-8 text-center md:gap-10">
      <div data-reveal>
        <Eyebrow dotClass="bg-purple-500">{eyebrow}</Eyebrow>
      </div>
      <h2
        data-reveal="title"
        class="max-w-[952px] font-serif text-h5 font-normal"
      >
        {headline}
      </h2>
      <div
        data-reveal
        class="flex flex-wrap items-center justify-center gap-x-4 gap-y-3"
      >
        {
          capabilities.map((label) => (
            <span class="inline-flex h-8 items-center rounded-full border border-black/24 px-5 text-sm font-semibold uppercase">
              {label}
            </span>
          ))
        }
      </div>
    </header>

    {/* ---- Stepper -------------------------------------------------------- */}
    {/* On lg + motion the stage pins and vertical scroll advances the active step
        (one step per scroll segment; see the pin script below), the icon navbar
        syncs to it and a click smooth-scrolls to that step. Below lg / reduced
        motion the pin is off and it's the plain click stepper.
        NB: no data-reveal on the stage — its will-change/transform would make it a
        backdrop-filter boundary and kill the frosted tooltip inside the nav. The
        reveal lives on the panel stack below instead. */}
    <div data-hiw-track class="hiw-track w-full">
      <div
        data-hiw-stage
        class="hiw-stage relative mx-auto flex w-full max-w-[1064px] flex-col gap-8 lg:max-w-[1208px] lg:flex-row lg:items-start lg:gap-[clamp(2rem,4vw,52px)]"
      >
      {/* Lateral icon navbar. Mobile: prev/next arrows flank the icon pill
          (Figma 9335:319), spread full-width. lg+: the plain vertical pill —
          the arrows hide and the wrapper unwraps (`contents`) so the pill
          becomes the stage's left column exactly as before. */}
      <div
        class="flex w-full items-center justify-between gap-3 lg:contents"
      >
        <button
          type="button"
          data-hiw-prev
          aria-label="Previous step"
          class="grid size-10 shrink-0 place-items-center rounded-3xl border border-dotted border-black/30 text-black transition-colors duration-200 hover:border-black/60 lg:hidden"
        >
          <svg
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.5"
            stroke-linecap="round"
            stroke-linejoin="round"
            class="size-6 rotate-180"
            aria-hidden="true"
          >
            <path d="M18.5 12H5" />
            <path d="M13 18C13 18 19 13.5811 19 12C19 10.4188 13 6 13 6" />
          </svg>
        </button>

        <nav
          role="tablist"
          aria-label="How it works steps"
          class="flex shrink-0 flex-row gap-2 self-center rounded-card bg-ink-wash p-2 lg:flex-col lg:self-center"
        >
        {
          steps.map((step, i) => (
            <button
              type="button"
              role="tab"
              data-step-btn={i}
              id={`hiw-tab-${i}`}
              aria-controls={`hiw-panel-${i}`}
              aria-selected={i === 0 ? "true" : "false"}
              aria-label={step.navLabel}
              class="group/step relative grid size-10 place-items-center rounded-3xl border transition-colors duration-300 ease-[cubic-bezier(0.33,1,0.68,1)] border-gray-200 text-black/40 hover:border-purple-100 hover:bg-purple-tint hover:text-black aria-selected:border-transparent aria-selected:bg-brand aria-selected:text-white"
            >
              <svg
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="1.5"
                stroke-linecap="round"
                stroke-linejoin="round"
                class="size-6"
                aria-hidden="true"
                set:html={icons[step.icon]}
              />
              {/* Hover tooltip: the step title in a frosted-glass pill floating to
                  the right of the icon (design node). Desktop-only. */}
              <span
                aria-hidden="true"
                class="pointer-events-none absolute left-full top-1/2 z-20 ml-4 hidden h-10 -translate-y-1/2 items-center whitespace-nowrap rounded-full border border-gray-200 bg-white/45 px-6 text-sm font-semibold uppercase text-black opacity-0 backdrop-blur-[20px] transition-opacity duration-200 lg:inline-flex lg:group-hover/step:opacity-100 lg:group-aria-[selected=true]/step:!opacity-0"
              >
                {step.navLabel}
              </span>
            </button>
          ))
        }
        </nav>

        <button
          type="button"
          data-hiw-next
          aria-label="Next step"
          class="grid size-10 shrink-0 place-items-center rounded-3xl border border-dotted border-black/30 text-black transition-colors duration-200 hover:border-black/60 lg:hidden"
        >
          <svg
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.5"
            stroke-linecap="round"
            stroke-linejoin="round"
            class="size-6"
            aria-hidden="true"
          >
            <path d="M18.5 12H5" />
            <path d="M13 18C13 18 19 13.5811 19 12C19 10.4188 13 6 13 6" />
          </svg>
        </button>
      </div>

      {/* Panels — stacked in one grid cell so the area sizes to the tallest
          step and panels crossfade in place. */}
      <div data-reveal class="hiw-stack grid flex-1">
        {
          steps.map((step, i) => (
            <div
              data-step-panel={i}
              role="tabpanel"
              id={`hiw-panel-${i}`}
              aria-labelledby={`hiw-tab-${i}`}
              hidden={i !== 0}
              class="hiw-panel flex flex-col items-stretch gap-8 lg:flex-row lg:items-center lg:justify-between lg:gap-12"
            >
              <div class="flex flex-col gap-6 lg:max-w-[473px]">
                <p class="text-sm font-semibold uppercase">
                  {step.eyebrow}
                </p>
                <h3 class="font-serif text-h6 font-normal">
                  {step.heading}
                </h3>
                {/* Body sits under the heading on desktop; on mobile it moves
                    below the media (see the copy after the media card). */}
                <p class="hidden whitespace-pre-line text-[clamp(1.125rem,2vw,24px)] font-normal lg:block">
                  {step.body}
                </p>
              </div>
              <div class="w-full shrink-0 lg:h-[616px] lg:w-[522px]">
                {/* Mobile: the uniform design image (Figma export). */}
                <img
                  src={hiwMedia[step.media]}
                  alt=""
                  loading="lazy"
                  class="aspect-[358/364] w-full rounded-card object-cover md:aspect-auto md:h-[231px] lg:hidden"
                />
                {/* Desktop: the built, interactive media card. */}
                <div class="hidden h-full w-full place-items-center overflow-hidden rounded-card bg-white lg:grid">
                {step.media === "enrollment" ? (
                  <div class="flex w-full max-w-[380px] flex-col gap-5 rounded-3xl bg-blue-100 p-6">
                    <p class="text-lg font-semibold text-ink">
                      {step.enrollment?.title}
                    </p>

                    {/* Progress bar */}
                    <div class="h-1.5 w-full overflow-hidden rounded-full bg-white">
                      <div
                        class="h-full rounded-full bg-purple-200"
                        style={`width:${step.enrollment?.progressValue}%`}
                      />
                    </div>

                    {/* Matching-population row */}
                    <div class="flex items-center gap-3">
                      <span class="grid size-8 shrink-0 place-items-center rounded-full bg-purple-200 text-ink">
                        <svg
                          viewBox="0 0 24 24"
                          fill="none"
                          stroke="currentColor"
                          stroke-width="1.5"
                          stroke-linecap="round"
                          class="size-4"
                          aria-hidden="true"
                          set:html={`<path d="M12 2v4"/><path d="m16.2 7.8 2.9-2.9"/><path d="M18 12h4"/><path d="m16.2 16.2 2.9 2.9"/><path d="M12 18v4"/><path d="m4.9 19.1 2.9-2.9"/><path d="M2 12h4"/><path d="m4.9 4.9 2.9 2.9"/>`}
                        />
                      </span>
                      <span class="text-ink">{step.enrollment?.progressLabel}</span>
                      <span class="ml-auto font-semibold text-ink">
                        {step.enrollment?.progressValue}%
                      </span>
                    </div>

                    {/* Patient list — fades out down the queue */}
                    <div class="flex flex-col">
                      {step.enrollment?.patients.map((patient, i) => (
                        <div
