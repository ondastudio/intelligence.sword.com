---
/**
 * SolutionsHero — the "Solution" landing screen from the design.
 *
 * Desktop (Figma node 8634:517): light-lavender background with the navbar
 * overlaid, an eyebrow label above a full-width hairline divider, then a large
 * Lora headline + supporting paragraph on the left and a white media card on
 * the right. The animated lime swirl blooms full-bleed behind everything.
 *
 * Mobile (Figma node 9328:194): the same pieces stacked top-down — eyebrow +
 * divider, headline, paragraph, then a full-width white rounded rectangle at
 * the bottom that holds the looping surgery animation. The lime swirl keeps its
 * full-bleed position behind the whole hero (a static lime wash on mobile).
 *
 * Content comes from src/data/solutions.json.
 */
import solutions from "../../data/solutions.json";
import Navbar from "../layout/Navbar.astro";
import Eyebrow from "../ui/Eyebrow.astro";

const { eyebrow, headline, paragraph } = solutions.hero;
---

<section
  class="relative flex flex-col overflow-hidden bg-purple-tint text-black lg:min-h-screen"
>
  <!-- Animated neon-lime swirl bloom, behind the hero content. The shared hero
       swirl recoloured to the lime palette; a static CSS lime wash is the
       no-JS / reduced-motion / mobile fallback. Sits at z-0 below the content
       (z-10) and the navbar (z-20). -->
  <div
    data-sol-swirl-stage
    aria-hidden="true"
    class="sol-swirl pointer-events-none absolute z-0"
  >
    <canvas
      data-sol-swirl
      class="absolute inset-0 h-full w-full opacity-0 transition-opacity duration-700"
    ></canvas>
  </div>

  <Navbar />

  <div
    class="relative z-10 mx-auto flex w-full max-w-[1440px] flex-col px-5 lg:min-h-screen lg:px-20"
  >
    <!-- Eyebrow label + full-width hairline divider -->
    <div class="pt-[128px] lg:pt-[200px]">
      <div data-reveal class="lg:pl-[11px]">
        <Eyebrow dotClass="bg-purple-500">{eyebrow}</Eyebrow>
      </div>
      <div
        data-reveal="line"
        class="mt-10 border-t border-black/24 lg:mt-5 lg:-mx-16"
      >
      </div>
    </div>

    <!-- Headline + paragraph (left) and media card (right) -->
    <div
      class="mt-10 flex flex-col gap-16 pb-12 lg:mt-auto lg:flex-row lg:items-stretch lg:justify-between lg:gap-16 lg:pb-20"
    >
      <div
        class="flex flex-col gap-16 lg:max-w-[853px] lg:justify-between lg:gap-0"
      >
        <h1 data-reveal="title" class="font-serif font-normal text-h2">
          {headline}
        </h1>
        <p
          data-reveal
          class="text-lg lg:max-w-[607px]"
          style="transition-delay:120ms"
        >
          {paragraph}
        </p>
      </div>

      <!-- Media card — the looping surgery clip (the same clip the Care
           "Surgery Prehab and Rehab" card uses). Full-width white rectangle on
           mobile, a portrait card on desktop. On mobile the clip is inset
           (40px top/bottom, 32px left/right) and object-contained so it's never
           cropped; on desktop it fills the card (object-cover).
           overflow-hidden clips it to the radius; bg-white shows while it
           loads. -->
      <div
        data-reveal
        class="relative aspect-[350/364] w-full overflow-hidden rounded-[40px] bg-white md:aspect-auto md:h-[650px] lg:aspect-[305/381] lg:h-auto lg:max-w-[305px] lg:shrink-0 lg:self-end lg:rounded-[32px]"
        style="transition-delay:200ms"
      >
        <video
          src="/triage/surgery.webm"
          class="absolute left-8 top-10 h-[calc(100%-80px)] w-[calc(100%-64px)] object-contain md:left-[30px] md:top-[30px] md:h-[calc(100%-60px)] md:w-[calc(100%-60px)] md:object-contain lg:left-0 lg:top-0 lg:h-full lg:w-full lg:object-cover"
          loop
          muted
          playsinline
          preload="none"
          data-lazy-video
          aria-hidden="true"></video>
      </div>
    </div>
  </div>
</section>

<style>
  /* Mobile / no-JS fallback: a soft neon-lime wash blooming from the centre,
     fading out toward the edges so it never overpowers the copy. The animated
     canvas is hidden here (desktop re-enables it below). */
  .sol-swirl {
    inset: 0;
    background: radial-gradient(
      90% 70% at 50% 50%,
      color-mix(in srgb, var(--color-accent) 55%, transparent),
      color-mix(in srgb, var(--color-accent) 24%, transparent) 40%,
      transparent 70%
    );
  }
  .sol-swirl canvas {
    display: none;
  }

  /* Desktop: the animated circular lime swirl, centred behind the hero content.
     `top`/`left` mark the bloom's centre (the layer is pulled back by half its
     own size); a radial mask keeps it a soft circular bloom. The background is
     the no-JS / reduced-motion fallback wash. */
  @media (min-width: 1024px) {
    .sol-swirl {
      inset: auto;
      left: 50%;
      top: 50%;
      width: 90%;
      height: 150%;
      transform: translate(-50%, -50%);
      background: radial-gradient(
        circle closest-side at 50% 50%,
        color-mix(in srgb, var(--color-accent) 42%, transparent),
        transparent 68%
      );
      -webkit-mask-image: radial-gradient(
        circle closest-side at 50% 50%,
        #000 0%,
        #000 16%,
        transparent 70%
      );
      mask-image: radial-gradient(
        circle closest-side at 50% 50%,
        #000 0%,
        #000 16%,
        transparent 70%
      );
    }
    .sol-swirl canvas {
      display: block;
    }
  }
</style>

<script>
  // Animated neon-lime swirl bloom — the shared hero swirl recoloured to the
  // lime palette, blooming from the right (circular, gentle drift). Matches the
  // Scaling section's lime bloom so the two read as one visual language.
  import { initSwirl } from "../../lib/swirl";

  const stage = document.querySelector<HTMLElement>("[data-sol-swirl-stage]");
  const canvas = stage?.querySelector<HTMLCanvasElement>(
    "canvas[data-sol-swirl]",
  );

  // Desktop-only: on mobile the bloom is a static CSS wash (see the <style>
  // block) and the canvas is hidden, so there's no need to spin up WebGL there.
  if (stage && canvas && window.matchMedia("(min-width: 1024px)").matches) {
    initSwirl(canvas, stage, {
      grainUrl: "/hero/swirl/perlin1.png",
      circular: true,
      warp: 0.6, // gentle drift, cohesive blob
      speed: 4.6, // fast drift
      falloffStart: 0.5,
      falloffEnd: 0.94,
      colors: {
        bgColor: [0.98, 0.99, 0.96], // outer field — near-white
        soft: [0.9, 0.99, 0.62], // inner core — bright lime
        body: [0.8, 1.0, 0.22], // dominant bloom — neon lime (#ccff33)
        lavender: [0.92, 0.99, 0.72], // secondary highlight — pale lime
        crest: [0.97, 0.97, 0.97], // gradient crest — white
      },
    });
    requestAnimationFrame(() => canvas.classList.remove("opacity-0"));
  }
</script>
