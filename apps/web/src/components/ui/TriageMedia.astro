---
/**
 * TriageMedia — the looping app-screen clip that fills a SolutionCard's media
 * panel in the Triage section. Every use case uses the same treatment: a muted,
 * autoplaying video that covers the panel. Content-free — the clip URL comes
 * from `data/triage.json` (`card.media` / `orchestration.cards[].media`).
 *
 * `media` is the resolved file URL. A legacy `{ src }` object is tolerated so an
 * un-reseeded CMS document keeps rendering.
 */
interface Props {
  media: string | { src?: string };
}
const { media } = Astro.props;
const src = typeof media === "string" ? media : media?.src;
---

{
  src && (
    <video
      src={src}
      class="absolute inset-0 h-full w-full object-cover"
      autoplay
      loop
      muted
      playsinline
      preload="auto"
      aria-hidden="true"
    />
  )
}
